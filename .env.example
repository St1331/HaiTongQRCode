# Web
NEXT_PUBLIC_API_BASE_URL=/api/v1

# API
API_PORT=3001
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
SESSION_HMAC_SECRET=replace-with-at-least-32-random-characters
IP_HMAC_SECRET=replace-with-a-different-32-character-secret
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_MINUTES=1440
TRUST_PROXY_HOPS=0
PUBLIC_IP_RATE_LIMIT=6000
PUBLIC_TOKEN_RATE_LIMIT=6000
PUBLISH_CONTRACT_AMOUNT=false
COOKIE_SECURE=false

# PostgreSQL
POSTGRES_DB=haitong_qrcode
POSTGRES_USER=haitong
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://haitong:replace-with-a-local-development-password@localhost:5432/haitong_qrcode
