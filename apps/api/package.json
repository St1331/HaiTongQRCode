{
  "name": "@haitong/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "pnpm --filter @haitong/shared build && pnpm build && node dist/scripts/migrate.js",
    "db:migrate:compiled": "node dist/scripts/migrate.js",
    "db:revert": "pnpm --filter @haitong/shared build && pnpm build && node dist/scripts/revert-migration.js",
    "db:revert:compiled": "node dist/scripts/revert-migration.js",
    "db:seed-admin": "pnpm --filter @haitong/shared build && pnpm build && node dist/scripts/seed-admin.js",
    "db:seed-admin:compiled": "node dist/scripts/seed-admin.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@haitong/shared": "workspace:*",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.1.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@haitong/eslint-config": "workspace:*",
    "@haitong/tsconfig": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jsqr": "^1.4.0",
    "pino-pretty": "13.1.3",
    "pngjs": "^7.0.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
